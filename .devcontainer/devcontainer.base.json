{
  "name": "Agent Sandboxing Framework",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:UTC}"
    }
  },
  "runArgs": [
    "--user=1000:1000"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/sandbox,type=bind,consistency=delegated,readonly=true",
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },
  "postStartCommand": "bash /workspace/sandbox/.devcontainer/on-start.sh",
  "waitFor": "postStartCommand",
  "remoteUser": "node"
}
