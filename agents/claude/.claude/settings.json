{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout .)",
      "Bash(git clean -f *)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git -C * add .)",
      "Bash(git -C * add -A)",
      "Bash(git -C * add --all)",

      "Bash(rm -rf *)",
      "Bash(rm -r *)",

      "Bash(chmod 777 *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",

      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(kill -9 *)",

      "Bash(sudo *)",
      "Bash(su *)",

      "Bash(curl *|*sh)",
      "Bash(curl *|*bash)",
      "Bash(wget *|*sh)",
      "Bash(wget *|*bash)",

      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",

      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",

      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(docker push *)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker build *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(npm install *)",
      "Bash(pnpm install *)",
      "Bash(yarn install *)",
      "Bash(pip install *)",
      "Bash(pipx install *)"
    ],
    "allow": [
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(semgrep scan *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/node/.claude/hooks/pretooluse-guard.sh"
          }
        ]
      }
    ]
  }
}