# secrets/claude.env — secrets ONLY for the claude agent.
# Merged on top of common.env when you run: ./sandbox.sh open claude
# Copy to secrets/claude.env and fill in. Gitignored.

# ANTHROPIC_API_KEY=sk-ant-...

# With BROKER_ENABLED=true this key is passed only to the LiteLLM container;
# Claude receives a short-lived broker token instead.
